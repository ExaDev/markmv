{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "_build": {
      "inputs": ["src/**/*.ts", "tsconfig*.json"],
      "outputs": ["dist/**", "tsconfig.tsbuildinfo"]
    },
    "_check": {
      "dependsOn": ["_typecheck", "_lint"],
      "outputs": []
    },
    "_knip": {
      "inputs": ["src/**/*.ts", "knip.config.ts"],
      "outputs": []
    },
    "_lint": {
      "dependsOn": ["_build"],
      "outputs": [".eslintcache"]
    },
    "_test": {
      "env": ["MARKMV_TEST_*"],
      "inputs": ["src/**/*.ts", "vitest.config.ts"],
      "outputs": ["coverage/**"]
    },
    "_typecheck": {
      "inputs": ["src/**/*.ts", "tsconfig*.json"],
      "outputs": []
    }
  }
}
