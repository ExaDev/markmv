{
  "$schema": "https://typedoc.org/schema.json",
  "entryPoints": ["src/index.ts"],
  "tsconfig": "tsconfig.build.json",
  "out": "docs",
  "name": "markmv",
  "readme": "README.md",
  "includeVersion": true,
  "hostedBaseUrl": "https://exadev.github.io/markmv/",
  "useHostedBaseUrlForAbsoluteLinks": true,
  "excludePrivate": true,
  "excludeInternal": true,
  "excludeExternals": true,
  "sort": ["kind", "instance-first", "alphabetical"],
  "categorizeByGroup": false,
  "defaultCategory": "Other",
  "categoryOrder": [
    "Commands",
    "Core",
    "Strategies",
    "Types",
    "Utilities",
    "*"
  ],
  "searchCategoryBoosts": {
    "Commands": 1.5,
    "Core": 1.25
  },
  "searchGroupBoosts": {
    "Classes": 1.5,
    "Functions": 1.25
  },
  "navigation": {
    "includeCategories": true,
    "includeGroups": false,
    "includeFolders": false
  },
  "navigationLinks": {
    "GitHub": "https://github.com/ExaDev/markmv",
    "npm": "https://www.npmjs.com/package/markmv",
    "Changelog": "https://github.com/ExaDev/markmv/blob/main/CHANGELOG.md"
  },
  "validation": {
    "notExported": true,
    "invalidLink": true,
    "invalidPath": true,
    "notDocumented": true
  },
  "requiredToBeDocumented": [
    "Class",
    "Constructor",
    "Function",
    "Interface",
    "Method",
    "Property",
    "TypeAlias",
    "Variable"
  ],
  "treatValidationWarningsAsErrors": true
}
